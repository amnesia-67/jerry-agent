# --- required ---------------------------------------------------------------
DISCORD_TOKEN=paste-your-bot-token-here

# --- what the agents work on ------------------------------------------------
# Absolute path to the repo agents are allowed to edit. Defaults to this folder,
# which is almost certainly not what you want at a hackathon.
JERRY_WORKSPACE=C:\Users\you\Documents\GitHub\the-big-hackathon-repo

# --- which agent ------------------------------------------------------------
# gemini | claude | codex | copilot | cursor | qwen | opencode | amp
JERRY_DEFAULT_AGENT=gemini

# --- limits -----------------------------------------------------------------
# Seconds before a single agent run is killed.
JERRY_TIMEOUT=900
# How many agent runs may happen at once across the whole bot.
JERRY_MAX_PARALLEL=2
# 1 = skip every tool approval (yolo / --dangerously-*). Fast and reckless.
# 0 = let edits through but keep each CLI's sandbox where it has one.
JERRY_FULL_AUTO=0

# --- access control (strongly recommended) ----------------------------------
# Jerry runs real coding agents on this machine. If ALL THREE lists are empty,
# anyone who can see the bot can edit your files. Any one of them being set
# locks out everybody who doesn't match, so a typo fails closed, not open.
#
# Handles, comma or space separated, no @, case-insensitive. Easiest to set,
# but a handle can be changed by its owner.
JERRY_ALLOWED_USERNAMES=
# Let someone in but limit them to specific agents. handle:agent, comma
# separated, several agents joined by | , * means all. Aliases resolve, so
# `chatgpt` records the codex backend. A grant also gets them through the
# door, so no need to list them above as well.
#   JERRY_USER_AGENTS=a.o.luzhnov:grok, papai0.3:chatgpt, sam:claude|grok
JERRY_USER_AGENTS=
# Numeric snowflake ids. Harder to look up, impossible to reassign.
# Discord > Settings > Advanced > Developer Mode, then right-click a name.
JERRY_ALLOWED_USER_IDS=
JERRY_ALLOWED_ROLE_IDS=

# --- behaviour --------------------------------------------------------------
# Comma-separated guild ids make slash commands appear instantly instead of
# waiting on Discord's global propagation.
JERRY_GUILD_IDS=
# 1 = each request gets its own thread (default). 0 = reply in the channel.
JERRY_USE_THREADS=1
# Leave off. Jerry only reads messages that mention him, and Discord delivers
# those without the privileged message content intent.
JERRY_MESSAGE_CONTENT=0
