# --- sub-Jerry: runs agents on YOUR machine ---------------------------------
# `python setup_sub.py` writes this file for you. These are the pieces.

# Your OWN bot token, not master Jerry's. One bot per person.
DISCORD_TOKEN=

# Your Discord @handle, no @. Used in logs and in master's JERRY_SUBS line.
JERRY_SUB_OWNER=

# The ONLY user id this sub takes orders from: master Jerry's bot user id.
# Anything else posting in the dispatch channel is ignored.
JERRY_MASTER_ID=

# The private channel master dispatches in. Jobs are only accepted here.
JERRY_DISPATCH_CHANNEL_ID=

# --- what happens on this machine -------------------------------------------
# Your own checkout. The only folder the agent touches.
JERRY_WORKSPACE=

# Which agent you signed in to here.
JERRY_DEFAULT_AGENT=claude
JERRY_TIMEOUT=900

# 1 = agents may run shell commands here unattended, no sandbox.
# 0 = they can write files, but commands are denied, and some agents then
#     exit 0 having quietly skipped them.
JERRY_FULL_AUTO=0
